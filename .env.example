# ---------------------------------------------------------------------------
# Summariser (required for real summaries; without it the desk falls back to
# raw article snippets and the pipeline still completes)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# llama-3.3-70b-versatile and llama-3.1-8b-instant were retired on 16 Aug 2026.
GROQ_MODEL=openai/gpt-oss-120b

# Model the crew's agents reason with. Kept separate from GROQ_MODEL because
# each Groq model carries its own tokens-per-day allowance on the free tier,
# and orchestration chatter would otherwise eat the budget the briefing needs.
CREW_AGENT_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Search backend (optional). Leave SERPER_API_KEY empty to use the keyless
# Google News RSS endpoint, which needs no account.
# ---------------------------------------------------------------------------
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Slack delivery. Set the webhook URL, or a bot token plus channel id.
# The webhook wins when both are present.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# ---------------------------------------------------------------------------
# Google Sheets, the system of record. Share the spreadsheet with the service
# account address as an Editor. Keep the private key's \n escapes intact.
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_TAB=Digest

# ---------------------------------------------------------------------------
# Editorial settings
# ---------------------------------------------------------------------------
NEWS_TOPICS=artificial intelligence,technology,finance,cryptocurrency
MAX_ARTICLES=12

# Shared secret guarding /api/cron and /api/run. Vercel sends it on its cron
# calls automatically once set; the dashboard's Run now button asks for it.
# Required: with it empty, every run over HTTP is refused.
CRON_SECRET=
